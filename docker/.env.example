# Hermes Desktop Plus Docker Environment Configuration

# Official Hermes Agent image tag the runtime is built on. Keep this in step
# with the pinned known-good tag (see install.sh, HERMES_KNOWN_GOOD_TAG).
HERMES_TAG=v0.22.1

# Host user that should own the data volume (the base image remaps its hermes
# user to these ids at boot). Defaults to the image's own 10000.
HERMES_UID=10000
HERMES_GID=10000

# Authentication method: 'password' or 'token' (refuses 'none' on 0.0.0.0)
HERMES_PLUS_AUTH=password

# Required when HERMES_PLUS_AUTH=password
HERMES_PLUS_PASSWORD=change-me-to-a-secure-password

# Optional: Cloudflare Tunnel token
# Required only when running with --profile tunnel
# Ensure the Cloudflare Tunnel hostname directs traffic to service: http://hermes-plus:9129
TUNNEL_TOKEN=

# Trust reverse proxy headers (set to 1 when behind Cloudflare Access or a reverse proxy)
HERMES_PLUS_TRUST_PROXY_HEADERS=0
