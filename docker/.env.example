# Hermes Desktop Plus Docker Environment Configuration

# Official Hermes Agent image tag the runtime is built on. Keep this in step
# with the pinned known-good tag (see install.sh, HERMES_KNOWN_GOOD_TAG).
HERMES_TAG=v0.22.1

# Host user that should own the data volume (the base image remaps its hermes
# user to these ids at boot). Defaults to the image's own 10000.
HERMES_UID=10000
HERMES_GID=10000

# Authentication method: 'password' or 'token' (refuses 'none' on 0.0.0.0)
HERMES_PLUS_AUTH=password

# Required when HERMES_PLUS_AUTH=password. Replace the placeholder below with
# your own password: the container refuses to start while this value is still
# 'change-me-to-a-secure-password', and also refuses an empty one, so a missing
# password cannot turn into a restart loop on an open port. (A mounted secret
# works too: set HERMES_PLUS_PASSWORD_FILE=/run/secrets/hermes-plus-password)
HERMES_PLUS_PASSWORD=change-me-to-a-secure-password

# Optional: Cloudflare Tunnel token
# Required only when running with --profile tunnel
# Ensure the Cloudflare Tunnel hostname directs traffic to service: http://hermes-plus:9129
TUNNEL_TOKEN=

# Trust reverse proxy headers (set to 1 when behind Cloudflare Access or a reverse proxy)
HERMES_PLUS_TRUST_PROXY_HEADERS=0

# Origins other than the sidecar's own that may drive it (comma-separated).
# The sidecar refuses a browser Origin that does not match the Host it was
# reached at, on unsafe methods and WebSocket upgrades. A browser at the
# published address needs nothing here; a native shell's webview does, e.g.
# HERMES_PLUS_ALLOWED_ORIGINS=tauri://localhost. See docs/security.md.
HERMES_PLUS_ALLOWED_ORIGINS=
