{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "ignoreDeprecations": "6.0",
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "rootDir": "..",
    "outDir": "build/electron-types"
  },
  "include": ["electron", "product-identity.cjs", "product-identity.d.cts", "update-feed.cjs", "update-feed.d.cts", "../shared/src/ansi.ts", "../shared/src/data-url-read-max.ts", "../shared/src/external-url.ts", "../shared/src/translucency.ts", "src/app/pane3d/protocol.ts"],
  "exclude": ["electron/**/*.e2e.mts"]
}
