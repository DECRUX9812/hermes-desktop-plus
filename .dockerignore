# Keep the Docker build context to what the two stages actually copy.
.git
.gitignore
.task
.oc
.venv
**/node_modules
**/__pycache__
**/*.pyc
**/.pytest_cache
# Build output: the ui stage rebuilds it, and a stale copy must never be baked
# into the runtime stage.
**/dist-webapp
**/ui_dist
# Secrets: docker/.env is the file docker/README.md §1 tells the user to create
# (it holds HERMES_PLUS_PASSWORD and TUNNEL_TOKEN). No stage needs it and the
# build context is shipped to the daemon, so keep it out. .env.example stays.
.env
**/.env
